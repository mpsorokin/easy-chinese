  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "predev": "npm run data",
    "dev": "vite --host",
    "prebuild": "npm run data",
    "build": "vite build",
    "preview": "vite preview --host",
    "data": "node scripts/build-data.ts",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "format": "oxfmt",
